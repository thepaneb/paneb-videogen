PORT=3000
# Uma chave simples OU várias, uma por usuário (cada um só vê os próprios vídeos e tem a própria cota):
APP_KEY=troque-esta-chave
# APP_KEYS=alice:chave-da-alice,bob:chave-do-bob
FILES_TTL_MIN=1440       # validade dos links de vídeo (também vale para links compartilhados)
# FILES_SECRET=          # opcional; padrão derivado das chaves. Defina para não invalidar links ao trocar chaves
PROVIDER=mock            # provedor padrão: mock | kling | comfyui
DAILY_LIMIT=20           # máx. de jobs por 24h (controle de custo)
JOB_TIMEOUT_MIN=15
DATA_DIR=data
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_MODEL=kling-v2-6   # confira no console quais model_name sua conta enxerga
COMFY_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=workflows/ltx2.api.json   # workflow exportado em API Format, com placeholders {{...}}
COMFY_WORKFLOW_I2V=                      # opcional: workflow separado para imagem→vídeo
COMFY_FPS=24
COMFY_DURATIONS=5,10                     # reduza em GPUs com pouca VRAM, ex.: 3,5

# --- Observabilidade ---
LOG_LEVEL=info           # debug | info | warn | error (logs JSON, uma linha por evento)
# METRICS_TOKEN=         # habilita GET /metrics (Prometheus) com "Authorization: Bearer <token>"; sem isso a rota responde 404
# --- Variações ---
MAX_VARIATIONS=4         # máximo de jobs por POST /jobs/:id/repeat
# --- Aprimorador de prompt (opcional; envia o texto do prompt para a API da Anthropic) ---
# ANTHROPIC_API_KEY=
# PROMPT_MODEL=claude-haiku-5-5   # confira o nome do modelo na sua conta
# ENHANCE_LANGUAGE=en             # en (padrão: modelos de vídeo costumam responder melhor) | same
# ENHANCE_DAILY_LIMIT=100         # por usuário/dia
