PORT=3000
# Uma chave simples OU várias, uma por usuário (cada um só vê os próprios vídeos e tem a própria cota):
APP_KEY=troque-esta-chave
# APP_KEYS=alice:chave-da-alice,bob:chave-do-bob
FILES_TTL_MIN=1440       # validade dos links de vídeo (também vale para links compartilhados)
# FILES_SECRET=          # opcional; padrão derivado das chaves. Defina para não invalidar links ao trocar chaves
PROVIDER=mock            # provedor padrão: mock | kling | comfyui | comfyui-wan | comfyui-wan13 | comfyui-wanfun | generic-*
# Provedor agregador genérico (qualquer API REST de texto→vídeo): veja docs/providers/generic.md
# GENERIC_PROVIDERS=replicate,fal
# GENERIC_REPLICATE_URL=https://api.replicate.com
# GENERIC_REPLICATE_CREATE=/v1/predictions
# GENERIC_REPLICATE_POLL=/v1/predictions/{id}
# GENERIC_REPLICATE_AUTH_HEADER=Authorization
# GENERIC_REPLICATE_AUTH_VALUE=Token <sua-chave>
# GENERIC_REPLICATE_CAPS={"durations":[5,10],"aspects":["9:16","1:1","16:9"],"qualities":["standard","hd"]}
DAILY_LIMIT=20           # máx. de jobs por 24h (controle de custo)
RATE_JOBS_PER_MINUTE=10  # limite de criação de jobs por usuário/minuto (POST /jobs + repeat); 0 desliga
JOB_TIMEOUT_MIN=15
WORKER_CONCURRENCY=2       # pool do worker: jobs independentes em paralelo (mínimo 1)
DATA_DIR=data
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_MODEL=kling-v2-6   # confira no console quais model_name sua conta enxerga
COMFY_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=workflows/ltx2-t2v.api.json   # texto→vídeo em API Format, com placeholders {{...}}
COMFY_WORKFLOW_I2V=workflows/ltx2-i2v.api.json # imagem→vídeo (mesmo esquema de placeholders)
COMFY_FPS=24
COMFY_DURATIONS=5,10                     # reduza em GPUs com pouca VRAM, ex.: 3,5
# Wan 2.2 5B (outro executor ComfyUI; ver docs/providers/comfyui-wan.md):
COMFY_WORKFLOW_WAN=workflows/wan2-t2v.api.json   # texto→vídeo (TI2V sem imagem de entrada)
COMFY_WORKFLOW_WAN_I2V=workflows/wan2-i2v.api.json # opcional: imagem→vídeo
COMFY_WAN_DURATIONS=5,10
# Wan 2.1 1.3B texto→vídeo (rascunho rápido em GPU modesta; ver docs/providers/comfyui-wan13.md):
COMFY_WORKFLOW_WAN13=workflows/wan21-t2v.api.json
COMFY_WAN13_DURATIONS=3,5
# Wan 2.1 Fun Camera 1.3B imagem→vídeo com câmera dirigida (ver docs/providers/comfyui-wanfun.md):
COMFY_WORKFLOW_WANFUN=workflows/wanfun-i2v.api.json
COMFY_WANFUN_DURATIONS=3,5
COMFY_WANFUN_MOTION=Zoom In   # Static | Pan Up | Pan Down | Pan Left | Pan Right | Zoom In | Zoom Out | Anti Clockwise (ACW) | ClockWise (CW)

# --- Observabilidade ---
LOG_LEVEL=info           # debug | info | warn | error (logs JSON, uma linha por evento)
# METRICS_TOKEN=         # habilita GET /metrics (Prometheus) com "Authorization: Bearer <token>"; sem isso a rota responde 404
# ADMIN_TOKEN=           # habilita o control plane e o painel (POST /admin/worker/*, GET /admin/worker/status, GET /admin/stats); sem isso respondem 404
# WORKER_STUCK_MIN=10    # job ativo sem atualização por mais que isso aparece em "stuck" no status do worker
# --- Variações ---
MAX_VARIATIONS=4         # máximo de jobs por POST /jobs/:id/repeat
# --- Aprimorador de prompt (opcional; envia o texto do prompt para a API da Anthropic) ---
# ANTHROPIC_API_KEY=
# PROMPT_MODEL=claude-haiku-5-5   # confira o nome do modelo na sua conta
# ENHANCE_LANGUAGE=en             # en (padrão: modelos de vídeo costumam responder melhor) | same
# ENHANCE_DAILY_LIMIT=100         # por usuário/dia
# --- Push (opcional; avisa o app ao concluir o job via FCM) ---
# FCM_PROJECT_ID=                # mesmo project id do app Android
# FIREBASE_SERVICE_ACCOUNT=      # JSON da conta de serviço ou caminho do arquivo
